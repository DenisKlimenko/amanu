{
  "manifest_version": 3,
  "name": "amanu — Meet speakers",
  "version": "0.1.0",
  "description": "Tells amanu who Google Meet shows as speaking, so meeting transcripts carry real names.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
